APP_NAME="Laravel"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_FORCE_HTTPS=false

LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=helper
DB_USERNAME=root
DB_PASSWORD=

# Real-time is off by default. Set BROADCAST_DRIVER=pusher and fill in the
# PUSHER_* credentials below to enable live board/notification updates.
BROADCAST_DRIVER=null
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Lifetime of API (Sanctum) tokens in minutes. Default 20160 = 14 days.
SANCTUM_TOKEN_EXPIRATION=20160

# Require Super Admins to enable two-factor auth before using the panel.
REQUIRE_2FA_FOR_SUPER_ADMIN=false

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@helper.app"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

GITHUB_ID=
GITHUB_SECRET=
GITHUB_URL="${APP_URL}/oauth/callback/github"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CLIENT_CALLBACK="${APP_URL}/oauth/callback/google"

# Internal services IP whitelist (comma-separated, supports CIDR)
INTERNAL_IP_WHITELIST="127.0.0.1,::1"

# Trusted load balancers / reverse proxies so $request->ip() sees the real
# client. Comma-separated IPs/CIDRs, or "*" to trust all forwarding proxies
# (only when the app is reachable exclusively through them). Empty = trust none.
TRUSTED_PROXIES=

# Error tracking & performance monitoring (Sentry).
# Leave the DSN empty to disable Sentry entirely (dev/test default).
SENTRY_LARAVEL_DSN=
# Fraction of requests traced for performance monitoring (0.0 - 1.0).
SENTRY_TRACES_SAMPLE_RATE=0.2
# Whether to send personally identifiable info (IP, cookies). Keep false.
SENTRY_SEND_DEFAULT_PII=false

# Full-text search (Laravel Scout). 'collection' (default) needs no external
# service. Set to 'meilisearch' in production and configure the host/key below.
SCOUT_DRIVER=collection
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_KEY=
