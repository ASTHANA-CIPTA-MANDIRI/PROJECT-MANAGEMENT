APP_NAME="Laravel"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_FORCE_HTTPS=false

LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=helper
DB_USERNAME=root
DB_PASSWORD=

# Real-time is off by default. Set BROADCAST_DRIVER=pusher and fill in the
# PUSHER_* credentials below to enable live board/notification updates.
BROADCAST_DRIVER=null
CACHE_DRIVER=file
FILESYSTEM_DISK=local
# Ticket attachments and project covers. Keep this off the "public" disk -
# it is served straight through the storage/ symlink with no auth check.
MEDIA_DISK=media
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Lifetime of API (Sanctum) tokens in minutes. Default 20160 = 14 days.
SANCTUM_TOKEN_EXPIRATION=20160

# Require Super Admins to enable two-factor auth before using the panel.
REQUIRE_2FA_FOR_SUPER_ADMIN=true

# DefaultUserSeeder (db:seed). Leave both unset in shared/production envs:
# the seeder then generates a strong random password and prints it once,
# so no weak credential ever ships in code. Set both here (in your own
# untracked .env, never here in .env.example) for a known local login.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# The plain "Employee" account the seeder adds outside production only.
# Same rule: leave the password unset to get a generated one.
SEED_USER_EMAIL=
SEED_USER_PASSWORD=

MEMCACHED_HOST=127.0.0.1

# Redis powers cache, sessions and the queue (with Laravel Horizon) in
# production. predis is the default client so no PHP extension is required.
# For scale, set CACHE_DRIVER=redis, SESSION_DRIVER=redis,
# QUEUE_CONNECTION=redis above (requires a running Redis server), then run
# `php artisan horizon`.
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@helper.app"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

GITHUB_ID=
GITHUB_SECRET=
GITHUB_URL="${APP_URL}/oauth/callback/github"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CLIENT_CALLBACK="${APP_URL}/oauth/callback/google"

# Internal services IP whitelist (comma-separated, supports CIDR)
INTERNAL_IP_WHITELIST="127.0.0.1,::1"

# Trusted load balancers / reverse proxies so $request->ip() sees the real
# client. Comma-separated IPs/CIDRs, or "*" to trust all forwarding proxies
# (only when the app is reachable exclusively through them). Empty = trust none.
TRUSTED_PROXIES=

# Content-Security-Policy header. Set to false to drop the header entirely
# (e.g. while debugging a blocked resource). See config/security.php.
CSP_ENABLED=true
# Overrides the default CSP directive string built in config/security.php.
# Leave unset to use that default.
CONTENT_SECURITY_POLICY=
# HTTP Strict-Transport-Security header value, only sent on HTTPS requests.
HSTS_HEADER="max-age=31536000; includeSubDomains"

# Jira import. The host entered in the wizard is always refused when it
# resolves to a private/reserved address (see config/jira.php). Optionally
# restrict it further to an allowlist, e.g. "*.atlassian.net,jira.example.com".
# Empty = any public https host is allowed.
JIRA_ALLOWED_HOSTS=
# Only enable for a self-hosted Jira on a trusted network: credentials are sent
# as a Basic auth header, so https is required by default.
JIRA_ALLOW_HTTP=false
JIRA_TIMEOUT=10
JIRA_CONNECT_TIMEOUT=5

# Error tracking & performance monitoring (Sentry).
# Leave the DSN empty to disable Sentry entirely (dev/test default).
SENTRY_LARAVEL_DSN=
# Fraction of requests traced for performance monitoring (0.0 - 1.0).
SENTRY_TRACES_SAMPLE_RATE=0.2
# Whether to send personally identifiable info (IP, cookies). Keep false.
SENTRY_SEND_DEFAULT_PII=false

# Full-text search (Laravel Scout). 'collection' (default) needs no external
# service. Set to 'meilisearch' in production and configure the host/key below.
SCOUT_DRIVER=collection
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_KEY=
